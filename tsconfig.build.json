{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        // Only the ES2022 language library: no Node and no DOM typings, so nothing from them can leak into dist/*.d.ts
        // and the sources cannot use an API that is not in ES2022 (the oldest runtime is Node 20).
        "lib": ["es2022"],
        "types": [],
        "noEmit": false,
        "rootDir": "src",
        "outDir": "dist",
        "rewriteRelativeImportExtensions": true,
        "sourceMap": true,
        "inlineSources": true,
        "declaration": true,
        // Declarations marked @internal (the engine state, test switches, internal option types) stay out of dist/*.d.ts.
        "stripInternal": true,
        "removeComments": false
    },
    "include": ["src/**/*.ts"]
}
