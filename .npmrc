# npm 12 refuses a dependency fetched from a URL unless the config allows it (EALLOWREMOTE). The only one is the dev dependency
# `xpath-fork`, a release tarball of github.com/bugsee/xpath that the differential harness compares against, pinned by
# integrity in package-lock.json. `root` allows remote tarballs for the project's own dependencies only, not for what a
# dependency pulls in. npm 10 and 11 do not know the setting and ignore it. Checked with npm 10, 11 and 12.2.0.
allow-remote=root
